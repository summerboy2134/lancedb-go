# Copy this file to .env and fill in the UFile values. The real .env file is
# ignored by Git. Never commit access keys or secret keys.
#
# URI must include a bucket and a disposable base prefix, for example:
# s3://my-test-bucket/lancedb-go-sdk-concurrency
LANCEDB_TEST_UFILE_URI=
LANCEDB_TEST_UFILE_ENDPOINT=
LANCEDB_TEST_UFILE_ACCESS_KEY=
LANCEDB_TEST_UFILE_SECRET_KEY=

# Optional UFile S3-compatible settings. Leave a value empty to let the
# object_store/Lance backend use its default.
LANCEDB_TEST_UFILE_REGION=
LANCEDB_TEST_UFILE_SESSION_TOKEN=
LANCEDB_TEST_UFILE_ALLOW_HTTP=
LANCEDB_TEST_UFILE_VIRTUAL_HOSTED_STYLE_REQUEST=
LANCEDB_TEST_UFILE_UNSIGNED_PAYLOAD=
LANCEDB_TEST_UFILE_CONDITIONAL_PUT=
LANCEDB_TEST_UFILE_COPY_IF_NOT_EXISTS=
LANCEDB_TEST_UFILE_DISABLE_TAGGING=

# Set to true only when Docker/MinIO is intentionally unavailable.
LANCEDB_TEST_SKIP_MINIO=false

# Optional MergeInsert retry timeout, for example 30s or 2m.
# Empty means use the current SDK/Lance default.
LANCEDB_TEST_MERGE_TIMEOUT=
